{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pzdn2009.github.io/shannian-app/data/dharma-events/v2/schema.json",
  "title": "Shannian Dharma Event Catalog v2",
  "type": "object",
  "required": ["protocolVersion", "revision", "region", "timeZone", "updatedAt", "temples", "events"],
  "properties": {
    "protocolVersion": {"const": 2},
    "revision": {"type": "string", "minLength": 1},
    "region": {"const": "SG"},
    "timeZone": {"const": "Asia/Singapore"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "temples": {"type": "array", "items": {"$ref": "#/$defs/temple"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "additionalProperties": false,
  "$defs": {
    "httpsURL": {"type": "string", "format": "uri", "pattern": "^https://"},
    "temple": {
      "type": "object",
      "required": ["id", "name", "address"],
      "properties": {
        "id": {"type": "string", "pattern": "^sg\\."},
        "name": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "website": {"$ref": "#/$defs/httpsURL"},
        "logoURL": {"$ref": "#/$defs/httpsURL"},
        "phone": {"type": "string"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["id", "title", "start"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "poster": {
      "type": "object",
      "required": ["url", "thumbnailURL", "width", "height", "alt"],
      "properties": {
        "url": {"$ref": "#/$defs/httpsURL"},
        "thumbnailURL": {"$ref": "#/$defs/httpsURL"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "assetPath": {"type": "string"},
        "alt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "templeID", "title", "temple", "address", "schedule", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^sg\\."},
        "templeID": {"type": "string", "pattern": "^sg\\."},
        "title": {"type": "string", "minLength": 1},
        "temple": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "schedule": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session"}},
        "poster": {"$ref": "#/$defs/poster"},
        "signupURL": {"$ref": "#/$defs/httpsURL"},
        "sourceURL": {"$ref": "#/$defs/httpsURL"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["draft", "published", "cancelled"]},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    }
  }
}
